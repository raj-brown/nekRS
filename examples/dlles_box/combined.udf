  int dlMode = 0; // 0 inference | 1 train-forward | 2 train-adjoint
  std::shared_ptr<Net> model;
  int closureType = 0;
  double kappa= 0.0;
  deviceMemory<dfloat> o_gradU, o_hkj;

void loadModel()
{
  const std::string path = "model.pt";
  std::ifstream f(path);
  if (!f.good()) {
    if (platform->comm.mpiRank() == 0) std::cerr << "ERROR: " << path << " not found\n";
    MPI_Abort(platform->comm.mpiComm(), EXIT_FAILURE);
  }
  model = std::make_shared<Net>();
  model->to(kModelDtype);
  torch::load(model, path);
  model->to(torch::kCUDA);

  if (platform->comm.mpiRank() == 0) {
    int64_t n = 0;
    for (auto &p : model->parameters()) n += p.numel();
    auto p0 = model->parameters()[0];
    std::cout << "dlLES: loaded " << path << ": " << n << " parameters, dtype=" << p0.dtype()
              << ", device=" << p0.device() << ", dlMode=" << dlMode << "\n";
  }
}
