[GENERAL]
verbose = false
polynomialOrder = 4
stopAt = numSteps
numSteps = 100001

dt = 1e-3
timeStepper = tombo2
subCyclingSteps = 2

#writeControl = simulationTime 
writeControl = steps
writeInterval = 1000

#regularization = hpfrt + nModes=1 + scalingCoeff=10
#regularization = avm + hpfresidual + vismaxcoeff=0.02 + scalingcoeff=0.1


[PRESSURE]
residualTol = 1e-06

[VELOCITY]
boundaryTypeMap = wall, inlet, outlet
viscosity = -2000
density = 1.0
residualTol = 1e-06



