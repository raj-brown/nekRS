c-----------------------------------------------------------------------
      subroutine usrdat2

      include 'SIZE'
      include 'TOTAL'

c      COMMON /SCNRS/ sc_nrs(10)
c      real           sc_nrs

c      z0 = 0.0
c      z1 = sc_nrs(1) 
c
c      call rescale_x(zm1,z0,z1)

      do iel=1,nelt
      do ifc=1,2*ndim
         if (boundaryID(ifc,iel) .eq. 4) then
              boundaryID(ifc,iel) = 0
         else if (boundaryID(ifc,iel) .eq. 5) then
              boundaryID(ifc,iel) = 0
         else if (boundaryID(ifc,iel) .eq. 6) then 
               boundaryID(ifc,iel) = 0
         else if (boundaryID(ifc,iel) .eq. 7) then 
               boundaryID(ifc,iel) = 0
         endif
      enddo
      enddo

      return
      end
