<<< #include "udf.hpp"
<<< #include <cmath>
<<< 
<<< 
<<< // divergence-free, 2*pi-periodic Taylor-Green-like field plus small extra modes
<<< void useric(nrs_t *nrs)
<<< {
<<<   auto mesh = nrs->meshV;
<<<   const dlong N = nrs->fieldOffset;
<<<   std::vector<dfloat> U(mesh->dim * N, 0.0);
<<<   auto [x, y, z] = mesh->xyzHost();
<<<   for (int i = 0; i < mesh->Nlocal; i++) {
<<<     U[i + 0 * N] =  std::sin(x[i]) * std::cos(y[i]) * std::cos(z[i]) + 0.2 * std::sin(z[i]);
<<<     U[i + 1 * N] = -std::cos(x[i]) * std::sin(y[i]) * std::cos(z[i]) + 0.2 * std::sin(x[i]);
<<<     U[i + 2 * N] =  0.1 * std::sin(y[i]);
<<<   }
<<<   nrs->fluid->o_solution().copyFrom(U.data(), U.size());
<<< }
<<< 
<<< void UDF_Setup() { useric(nrs); }
<<< 
<<< void UDF_ExecuteStep(double time, int tstep) {}

<<< #ifdef __okl__
<<< #include "combined.oudf"
<<< #endif
<<< #ifdef __okl__
<<< void udfDirichlet(bcData *bc){}
<<< void udfNeumann(bcData *bc){}
<<< void udfRobin(bcData *bc){}
<<< #endif

