#include "udf.hpp"
#include <torch/torch.h>
#include <torch/script.h>
#include <typeinfo>

#ifdef __okl__
#include "squareCyl.oudf"
#endif




const int Nepochs=10;

/* PyTorch Model
 */ 
struct Net:torch::nn::Module{
  torch::nn::Linear fc1{nullptr}, fc2{nullptr};

  Net(){
    fc1 = register_module("fc1", torch::nn::Linear(9, 64));
    fc2 = register_module("fc2", torch::nn::Linear(64, 9));
  }

  torch::Tensor forward(torch::Tensor x) {
    x = torch::relu(fc1->forward(x));
    x = fc2->forward(x);
    return x;
  }
};



deviceMemory<dfloat> o_gradU;
deviceMemory<dfloat> o_u;
deviceMemory<dfloat> o_hkj;
static std::shared_ptr<Net> model;



void useric(nrs_t *nrs)
{
  auto mesh = nrs->meshV;
  std::vector<dfloat> U(mesh->dim * nrs->fieldOffset, 0.0);
  dfloat ux = 1.0;
  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    auto [x, y, z] = mesh->xyzHost();
    for (int i = 1; i < mesh->Nlocal; i++) {
      U[i + 0 * nrs->fieldOffset] = ux;
      U[i + 1 * nrs->fieldOffset] = 0.0;
      U[i + 2 * nrs->fieldOffset] = 0.0;
    }
    nrs->fluid->o_solution().copyFrom(U.data(), U.size());
   }
}



void userf(double time){
  auto mesh = nrs->meshV;
  auto o_FUz = nrs->fluid->o_EXT + 2 * nrs->fieldOffset;
  platform->linAlg->fill(mesh->Nlocal, 0.0, o_FUz);
  std::cout << "Forcing is executed: " << nrs->fluid->o_EXT.size() <<  std::endl;
}

void closureSource(double time){

  mesh_t *mesh = nrs->meshV;
  dlong Ntotal = nrs->fluid->fieldOffset;
  occa::memory &o_U  = nrs->fluid->o_U;
  opSEM::strongGradVec(mesh, nrs->fieldOffset, o_U, o_gradU, true);

  dfloat *gradU_ptr = static_cast<dfloat*>(o_gradU.ptr());

  auto tensorOpts = torch::TensorOptions().dtype(torch::kFloat64).device(torch::kCUDA).requires_grad(false);

  torch::Tensor z = torch::from_blob(gradU_ptr, {9, Ntotal}, tensorOpts).t().contiguous();

  torch::Tensor h_kj;
  {
    torch::NoGradGuard no_grad;
    h_kj = model->forward(z);
  }

  torch::Tensor h_kj_T = h_kj.t().contiguous();
  o_hkj.copyFrom(h_kj_T.data_ptr<double>(), 9*Ntotal);
  

  for (int i=0; i < 3; ++i){
    auto o_row_i = o_hkj.slice(i*3*Ntotal, 3*Ntotal);

    occa::memory o_div_i = opSEM::strongDivergence(mesh, Ntotal, o_row_i, true);
    occa::memory o_EXT_i = nrs->fluid->o_EXT.slice(i * Ntotal, Ntotal);

    platform->linAlg->axpby(Ntotal, -1.0, o_div_i, 1.0, o_EXT_i);

    o_div_i.free();
  }

  platform->device.finish();

}


void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  std::cout<< "No Steup Zero!"<< std::endl;
}


void UDF_Setup()
{
  useric(nrs);
  nrs->userSource = &closureSource;
  dlong Ntotal = nrs->fieldOffset;
  o_gradU.resize(9 * Ntotal);
  o_hkj.resize(9 * Ntotal);

  for (int i=0; i<9; i++) {
    const auto sid = scalarDigitStr(i);
    auto o_utmp = o_gradU.slice(i * nrs->fieldOffset , nrs->meshV->Nlocal);
    nrs->addUserCheckpointField("scalar"+sid, std::vector<deviceMemory<dfloat>>{o_utmp});
  }

  model = std::make_shared<Net>();
  model->to(torch::kCUDA);
  //model->to(torch::kFloat64);
  std::ifstream checkFile("model.pt");
  if (checkFile.good()){
      torch::load(model, "model.pt");

      if (platform->comm.mpiRank() == 0){
        printf("nekRS: Loaded weights from model.pt\n");
        }
        else {
          if (platform->comm.mpiRank() == 0){
            printf("nekRS: No Checkpoints - random weights\n");
            }
        }

        model->to(torch::kCUDA);
        model->to(torch::kFloat64);





  }

    printf("nekRS: ClosureNet loaded on CUDA device\n");
  }




